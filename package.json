{
  "name": "social-embeds",
  "version": "0.9.0",
  "description": "Turn social media embed code or post URLs into working React components.",
  "keywords": [
    "react",
    "nextjs",
    "embed",
    "embed-code",
    "social-media",
    "social-embed",
    "twitter",
    "x",
    "instagram",
    "threads",
    "facebook",
    "tiktok",
    "youtube",
    "telegram",
    "snapchat",
    "linkedin",
    "reddit",
    "pinterest",
    "spotify",
    "vimeo",
    "twitch",
    "dailymotion",
    "bluesky",
    "soundcloud",
    "apple-music",
    "apple-podcasts",
    "tumblr",
    "kick",
    "giphy",
    "truth-social",
    "imgur",
    "tenor",
    "streamable",
    "strava",
    "flickr",
    "rumble",
    "iframe"
  ],
  "license": "MIT",
  "author": "Atanas Mitrev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitrev/social-embeds.git"
  },
  "bugs": "https://github.com/amitrev/social-embeds/issues",
  "homepage": "https://github.com/amitrev/social-embeds#readme",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.parser.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:directives": "node scripts/check-directives.mjs",
    "check:publint": "publint",
    "check:attw": "attw --pack . --profile esm-only",
    "check:element": "node scripts/check-element.mjs",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "es-module-lexer": "2.3.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
